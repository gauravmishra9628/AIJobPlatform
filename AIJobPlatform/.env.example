# ===================
# DJANGO SETTINGS
# ===================
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-secret-min-50-characters-long
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,api.yourdomain.com
DJANGO_ENV=production

# ===================
# DATABASE
# ===================
DATABASE_URL=postgres://aijobuser:password@postgres:5432/aijobplatform
POSTGRES_SSLMODE=require

# ===================
# REDIS & CELERY
# ===================
USE_REDIS=True
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===================
# AI/ML SERVICES
# ===================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_GEMINI_KEY=your-gemini-api-key

# ===================
# OAUTH
# ===================
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ===================
# PAYMENT (Stripe)
# ===================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ===================
# PAYMENT (Razorpay)
# ===================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ===================
# MONITORING (Sentry)
# ===================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===================
# SECURITY
# ===================
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ===================
# RATE LIMITING
# ===================
API_RATE_LIMIT_PER_MINUTE=60

# ===================
# FILE UPLOAD
# ===================
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760